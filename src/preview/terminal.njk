---
permalink: /preview/terminal/index.html
direction: terminal
title: "Direction C — Terminal"
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — Addable Labs design preview</title>
  <meta name="description" content="Design-direction preview: Terminal. Bold, dense, mono everywhere; bordered panels with title bars; a boot-sequence reveal.">
  <meta name="robots" content="noindex">
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#0A0C0E">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  {% include "preview/theme-script.njk" %}
  <link rel="preload" href="/assets/fonts/JetBrainsMono-Light.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/JetBrainsMono-Medium.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/preview/assets/fonts.css">
  <link rel="stylesheet" href="/preview/assets/terminal.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="preview-banner" role="note">
    <span><strong>Preview C · Terminal</strong> — bold, dense, mono everywhere; bordered panels with title bars; boot-sequence reveal.</span>
    <span><a href="/preview/signal/">A · Signal</a> · <a href="/preview/ledger/">B · Ledger</a></span>
  </div>
  <header class="site-header">
    <div class="container header-row">
      <a class="brand" href="/preview/terminal/" aria-label="Addable Labs, home">
        <span class="prompt" aria-hidden="true">+</span><span class="wordmark">addable_labs</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <ul>
          <li><a href="/preview/terminal/" aria-current="page">home</a></li>
          <li><a href="#services">services</a></li>
          <li><a href="#apps">apps</a></li>
          <li><a href="/blog/">blog</a></li>
          <li><a href="/about/">about</a></li>
        </ul>
      </nav>
      <div class="header-controls">
        <a class="lang-switch" href="/sv/" hreflang="sv" lang="sv">sv</a>
        {% include "preview/toggle.njk" %}
      </div>
    </div>
  </header>

  <main id="main" class="container">
    <section class="hero panel-grid boot" aria-labelledby="hero-title">
      <div class="panel panel-hero boot-item" style="--i:0">
        <p class="panel-bar"><span class="bar-tag">[ addable labs ]</span><span class="bar-note">AI-native software company · Sweden</span></p>
        <div class="panel-body">
          <h1 id="hero-title"><span class="prompt" aria-hidden="true">&gt; </span>{{ copy.hero.title }}<span class="caret" aria-hidden="true"></span></h1>
          <p class="lead">{{ copy.hero.lead }}</p>
          <p class="cta-row">
            <a class="button button-primary" href="{{ copy.hero.primaryHref }}">{{ copy.hero.primaryCta }}</a>
            <a class="button button-secondary" href="{{ copy.hero.secondaryHref }}">{{ copy.hero.secondaryCta }}</a>
          </p>
        </div>
      </div>
      <div class="panel panel-status boot-item" style="--i:1">
        <p class="panel-bar"><span class="bar-tag">[ status ]</span></p>
        <dl class="kv">
          <div><dt>founded</dt><dd>2026 · Sweden</dd></div>
          <div><dt>founder</dt><dd>Peter Blenessy</dd></div>
          <div><dt>team</dt><dd>small, senior, agents as staff</dd></div>
          <div><dt>stack</dt><dd>desktop · web · AI-native</dd></div>
          <div><dt>open source</dt><dd>5 public repositories</dd></div>
          <div><dt>this site</dt><dd><span class="ok">built by agents</span></dd></div>
        </dl>
        <ul class="proof">
          {%- for item in copy.hero.proof %}
          <li><span class="ok" aria-hidden="true">✓</span>{{ item }}</li>
          {%- endfor %}
        </ul>
      </div>
    </section>

    <section id="services" class="section" aria-labelledby="services-title">
      <h2 id="services-title" class="section-title"><span class="slash" aria-hidden="true">//</span>{{ copy.services.heading }}</h2>
      <div class="panel-grid cols-3">
        {%- for s in copy.services.items %}
        <article class="panel reveal" style="--i:{{ loop.index0 }}">
          <p class="panel-bar"><span class="bar-tag">[ 0{{ loop.index }} ]</span><span class="bar-note">{{ s.key }}</span></p>
          <div class="panel-body">
            <h3>{{ s.title }}</h3>
            <p>{{ s.text }}</p>
            <h4>{{ s.getsHeading }}</h4>
            <ul class="gets">
              {%- for g in s.gets %}
              <li>{{ g }}</li>
              {%- endfor %}
            </ul>
            <a class="text-link" href="{{ s.href }}">{{ s.cta }} <span aria-hidden="true">→</span></a>
          </div>
        </article>
        {%- endfor %}
      </div>
    </section>

    <section id="apps" class="section" aria-labelledby="apps-title">
      <h2 id="apps-title" class="section-title"><span class="slash" aria-hidden="true">//</span>{{ copy.apps.heading }}</h2>
      <p class="section-lead">{{ copy.apps.lead }}</p>
      <ul class="panel-grid cols-3 app-list">
        {%- for a in copy.apps.items %}
        <li class="panel app reveal{% if a.url %} app-linked{% endif %}" style="--i:{{ loop.index0 }}">
          <p class="panel-bar"><span class="bar-tag">[ {{ a.key }} ]</span><span class="bar-note status-{{ a.statusKind }}"><span class="status-dot" aria-hidden="true">●</span> {{ a.status }}</span></p>
          <div class="panel-body">
            <h3>{% if a.url %}<a href="{{ a.url }}">{{ a.name }} <span aria-hidden="true">↗</span></a>{% else %}{{ a.name }}{% endif %}</h3>
            <p class="app-theme">{{ a.theme }}</p>
            <p class="app-text">{{ a.text }}</p>
            {%- if not a.url %}
            <p class="app-private"><span aria-hidden="true">🔒 </span>private repository · no public link yet</p>
            {%- endif %}
          </div>
        </li>
        {%- endfor %}
      </ul>
    </section>

    <section id="how" class="section" aria-labelledby="trust-title">
      <h2 id="trust-title" class="section-title"><span class="slash" aria-hidden="true">//</span>{{ copy.trust.heading }}</h2>
      <div class="panel-grid cols-2">
        <div class="panel reveal" style="--i:0">
          <p class="panel-bar"><span class="bar-tag">[ how we work ]</span></p>
          <dl class="points">
            {%- for p in copy.trust.points %}
            <div><dt>{{ p.title }}</dt><dd>{{ p.text }}</dd></div>
            {%- endfor %}
          </dl>
        </div>
        <div class="panel reveal" style="--i:1">
          <p class="panel-bar"><span class="bar-tag">[ proof ]</span></p>
          <div class="panel-body">
            <ol class="log">
              <li><span class="log-k">requirements</span><span class="log-v">31 REQ · 29 AC</span><span class="ok">done</span></li>
              <li><span class="log-k">plan</span><span class="log-v">design review approved</span><span class="ok">done</span></li>
              <li><span class="log-k">implement</span><span class="log-v">10 items · 14 commits</span><span class="ok">done</span></li>
              <li><span class="log-k">gates</span><span class="log-v">build links html pages contrast parity feeds content</span><span class="ok">8/8</span></li>
              <li><span class="log-k">founder</span><span class="log-v">reviews every change</span><span class="wait">always</span></li>
            </ol>
            <p class="cta-row">
              <a class="button button-secondary" href="{{ copy.trust.articleHref }}">{{ copy.trust.articleLabel }}</a>
              <a class="text-link" href="{{ copy.trust.proofHref }}">{{ copy.trust.proofLabel }} <span aria-hidden="true">→</span></a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="writing" class="section" aria-labelledby="writing-title">
      <h2 id="writing-title" class="section-title"><span class="slash" aria-hidden="true">//</span>{{ copy.writing.heading }}</h2>
      <ol class="panel-grid cols-2 post-list">
        {%- for post in collections.posts_en %}
        <li class="panel post reveal" style="--i:{{ loop.index0 }}">
          <p class="panel-bar"><span class="bar-tag"><time datetime="{{ post.date | isoDate }}">{{ post.date | isoDate }}</time></span><span class="bar-note"><a class="chip" href="/blog/{{ post.data.category }}/">{{ strings.en.categories[post.data.category] }}</a>{% if post.data.draft %} <span class="chip chip-draft">draft</span>{% endif %}</span></p>
          <div class="panel-body">
            <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
            <p class="app-text">{{ post.data.description }}</p>
          </div>
        </li>
        {%- endfor %}
      </ol>
      <p><a class="text-link" href="/blog/">{{ copy.writing.all }} <span aria-hidden="true">→</span></a></p>
    </section>

    <section id="contact" class="section" aria-labelledby="contact-title">
      <div class="panel panel-contact reveal">
        <p class="panel-bar"><span class="bar-tag">[ contact ]</span><span class="bar-note">{{ copy.footer.email }}</span></p>
        <div class="panel-body contact-body">
          <div>
            <h2 id="contact-title"><span class="prompt" aria-hidden="true">&gt; </span>{{ copy.contact.heading }}</h2>
            <p class="lead">{{ copy.contact.text }}</p>
          </div>
          <p class="cta-row">
            <a class="button button-primary" href="{{ copy.contact.href }}">{{ copy.contact.cta }}</a>
            <a class="text-link" href="mailto:{{ copy.footer.email }}">{{ copy.footer.email }}</a>
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-row">
      <p class="footer-line"><span class="prompt" aria-hidden="true">+ </span>{{ copy.footer.factoryLine }}</p>
      <ul class="footer-list">
        <li><a href="mailto:{{ copy.footer.email }}">{{ copy.footer.email }}</a></li>
        <li class="placeholder">{{ copy.footer.linkedin }}</li>
        <li><a href="/sv/" hreflang="sv" lang="sv">{{ copy.footer.language }}</a></li>
        <li><a href="/feed.xml" type="application/rss+xml">{{ copy.footer.rss }}</a></li>
        <li>{% include "preview/toggle.njk" %}</li>
      </ul>
    </div>
  </footer>
  <script>
    (function () {
      var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var items = document.querySelectorAll(".reveal");
      if (reduce || !("IntersectionObserver" in window)) { for (var i = 0; i < items.length; i++) items[i].classList.add("is-visible"); return; }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); } });
      }, { rootMargin: "0px 0px -6% 0px", threshold: 0.05 });
      for (var j = 0; j < items.length; j++) io.observe(items[j]);
    })();
  </script>
</body>
</html>
