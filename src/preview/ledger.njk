---
permalink: /preview/ledger/index.html
direction: ledger
title: "Direction B — Ledger"
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — Addable Labs design preview</title>
  <meta name="description" content="Design-direction preview: Ledger. Editorial, centred, type-led; rules and whitespace instead of cards; minimal motion.">
  <meta name="robots" content="noindex">
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#0F1113">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  {% include "preview/theme-script.njk" %}
  <link rel="preload" href="/assets/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/preview/assets/fonts.css">
  <link rel="stylesheet" href="/preview/assets/ledger.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="preview-banner" role="note">
    <span><strong>Preview B · Ledger</strong> — editorial, centred, type-led; rules and whitespace instead of cards; minimal motion.</span>
    <span><a href="/preview/signal/">A · Signal</a> · <a href="/preview/terminal/">C · Terminal</a></span>
  </div>
  <header class="site-header">
    <div class="container header-row">
      <a class="brand" href="/preview/ledger/" aria-label="Addable Labs, home">
        <svg class="mark" viewBox="0 0 32 32" width="22" height="22" aria-hidden="true" focusable="false"><path d="M16 5v22M5 16h22" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
        <span class="wordmark">Addable Labs</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <ul>
          <li><a href="/preview/ledger/" aria-current="page">Home</a></li>
          <li><a href="#services">Services</a></li>
          <li><a href="#apps">Apps</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/about/">About</a></li>
          <li><a class="lang-switch" href="/sv/" hreflang="sv" lang="sv">Svenska</a></li>
        </ul>
      </nav>
      {% include "preview/toggle.njk" %}
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-inner">
        <p class="meta-line fade" style="--i:0"><span>Addable Labs</span><span aria-hidden="true">·</span><span>Sweden</span><span aria-hidden="true">·</span><span>AI-native</span></p>
        <h1 id="hero-title" class="fade" style="--i:1">{{ copy.hero.title }}</h1>
        <p class="lead fade" style="--i:2">{{ copy.hero.lead }}</p>
        <p class="cta-row fade" style="--i:3">
          <a class="button button-primary" href="{{ copy.hero.primaryHref }}">{{ copy.hero.primaryCta }}</a>
          <a class="button button-quiet" href="{{ copy.hero.secondaryHref }}">{{ copy.hero.secondaryCta }}<span class="arrow" aria-hidden="true">→</span></a>
        </p>
      </div>
      <nav class="toc container fade" style="--i:4" aria-label="On this page">
        <ol>
          <li><a href="#services"><span class="toc-num">01</span>Services</a></li>
          <li><a href="#apps"><span class="toc-num">02</span>Apps and products</a></li>
          <li><a href="#how"><span class="toc-num">03</span>How we work</a></li>
          <li><a href="#writing"><span class="toc-num">04</span>Writing</a></li>
          <li><a href="#contact"><span class="toc-num">05</span>Contact</a></li>
        </ol>
      </nav>
    </section>

    <section id="services" class="section container" aria-labelledby="services-title">
      <div class="section-label">
        <p class="num">01</p>
        <h2 id="services-title">{{ copy.services.heading }}</h2>
      </div>
      <div class="section-body">
        {%- for s in copy.services.items %}
        <article class="service">
          <h3><span class="num" aria-hidden="true">0{{ loop.index }}</span>{{ s.title }}</h3>
          <p>{{ s.text }}</p>
          <div class="gets-row">
            <h4>{{ s.getsHeading }}</h4>
            <ul class="gets">
              {%- for g in s.gets %}
              <li>{{ g }}</li>
              {%- endfor %}
            </ul>
          </div>
          <p><a class="text-link" href="{{ s.href }}">{{ s.cta }}<span class="arrow" aria-hidden="true">→</span></a></p>
        </article>
        {%- endfor %}
      </div>
    </section>

    <section id="apps" class="section container" aria-labelledby="apps-title">
      <div class="section-label">
        <p class="num">02</p>
        <h2 id="apps-title">{{ copy.apps.heading }}</h2>
        <p class="label-note">{{ copy.apps.lead }}</p>
      </div>
      <div class="section-body">
        <ol class="ledger">
          {%- for a in copy.apps.items %}
          <li class="ledger-row">
            <div class="ledger-name">
              <h3>{% if a.url %}<a href="{{ a.url }}">{{ a.name }}<span class="arrow" aria-hidden="true">↗</span></a>{% else %}{{ a.name }}{% endif %}</h3>
              <p class="ledger-theme">{{ a.theme }}</p>
            </div>
            <p class="ledger-text">{{ a.text }}</p>
            <p class="ledger-status status-{{ a.statusKind }}"><span class="status-main"><span class="status-dot" aria-hidden="true"></span><span>{{ a.status }}</span></span>{% if not a.url %}<span class="status-note">no public link yet</span>{% endif %}</p>
          </li>
          {%- endfor %}
        </ol>
      </div>
    </section>

    <section id="how" class="section container" aria-labelledby="trust-title">
      <div class="section-label">
        <p class="num">03</p>
        <h2 id="trust-title">{{ copy.trust.heading }}</h2>
      </div>
      <div class="section-body">
        <dl class="points">
          {%- for p in copy.trust.points %}
          <div class="point">
            <dt>{{ p.title }}</dt>
            <dd>{{ p.text }}</dd>
          </div>
          {%- endfor %}
        </dl>
        <p class="cta-row">
          <a class="button button-quiet" href="{{ copy.trust.articleHref }}">{{ copy.trust.articleLabel }}<span class="arrow" aria-hidden="true">→</span></a>
          <a class="text-link" href="{{ copy.trust.proofHref }}">{{ copy.trust.proofLabel }}</a>
        </p>
      </div>
    </section>

    <section id="writing" class="section container" aria-labelledby="writing-title">
      <div class="section-label">
        <p class="num">04</p>
        <h2 id="writing-title">{{ copy.writing.heading }}</h2>
      </div>
      <div class="section-body">
        <ol class="posts">
          {%- for post in collections.posts_en %}
          <li class="post">
            <p class="post-date"><time datetime="{{ post.date | isoDate }}">{{ post.date | isoDate }}</time></p>
            <div>
              <h3 class="post-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
              <p class="post-text">{{ post.data.description }}</p>
              <p class="post-meta"><a class="chip" href="/blog/{{ post.data.category }}/">{{ strings.en.categories[post.data.category] }}</a>{% if post.data.draft %} <span class="chip chip-draft">Draft</span>{% endif %}</p>
            </div>
          </li>
          {%- endfor %}
        </ol>
        <p><a class="text-link" href="/blog/">{{ copy.writing.all }}<span class="arrow" aria-hidden="true">→</span></a></p>
      </div>
    </section>

    <section id="contact" class="section container" aria-labelledby="contact-title">
      <div class="section-label">
        <p class="num">05</p>
        <h2 id="contact-title">{{ copy.contact.heading }}</h2>
      </div>
      <div class="section-body">
        <p class="lead">{{ copy.contact.text }}</p>
        <p class="cta-row">
          <a class="button button-primary" href="{{ copy.contact.href }}">{{ copy.contact.cta }}</a>
          <a class="text-link" href="mailto:{{ copy.footer.email }}">{{ copy.footer.email }}</a>
        </p>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-row">
      <p class="footer-line">{{ copy.footer.factoryLine }}</p>
      <ul class="footer-list">
        <li><a href="mailto:{{ copy.footer.email }}">{{ copy.footer.email }}</a></li>
        <li class="placeholder">{{ copy.footer.linkedin }}</li>
        <li><a href="/sv/" hreflang="sv" lang="sv">{{ copy.footer.language }}</a></li>
        <li><a href="/feed.xml" type="application/rss+xml">{{ copy.footer.rss }}</a></li>
        <li>{% include "preview/toggle.njk" %}</li>
      </ul>
    </div>
  </footer>
</body>
</html>
