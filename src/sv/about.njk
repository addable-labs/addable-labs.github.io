---
layout: layouts/base.njk
translationKey: about
machineTranslated: true
titleInContent: true
eleventyComputed:
  title: "{{ strings[lang].about.title | safe }}"
  description: "{{ strings[lang].about.description | safe }}"
---
{#- About page (REQ-012, REQ-016; plan D-12, A-04): the hero-style title, the
    founder section carrying the founding month, the approach as the trust
    points, a labelled card linking the "how this site was built" article as
    the approach in practice (founder call 2026-09-21: it replaced the
    GRC-fork note of A-04), and the contact band. Every string comes from
    strings[lang].about; the Swedish twin differs only in its
    machineTranslated flag. -#}
{%- set about = strings[lang].about -%}
{%- set langPrefix = "" if lang == site.languages.default else "/" + lang -%}
{%- set heroEyebrow = about.eyebrow -%}
{%- set heroTitle = about.title -%}
{%- set heroLead = about.lead -%}
{% include "partials/page-hero.njk" %}
<section class="section about-founder" aria-labelledby="founder-title">
  <div class="container trust-grid">
    <div class="trust-copy reveal">
      <h2 id="founder-title">{{ about.founderHeading }}</h2>
      <p class="founder-line">{{ about.founderLine }}</p>
    </div>
    {#- TODO(founder): review this paragraph — it is drawn only from the repository
        READMEs and the three themes (REQ-002, plan Decision 6). #}
    <p class="section-lead reveal">{{ about.founderWork }}</p>
  </div>
</section>
<section class="section section-alt about-approach" aria-labelledby="approach-title">
  <div class="container trust-grid">
    <div class="trust-copy reveal">
      <h2 id="approach-title">{{ about.approachHeading }}</h2>
    </div>
    <dl class="trust-points">
      {%- for key in ["aiNative", "team", "open", "proof"] %}
      <div class="trust-point reveal">
        <dt>{{ about.points[key].title }}</dt>
        <dd>{{ about.points[key].text }}</dd>
      </div>
      {%- endfor %}
    </dl>
    <aside class="card note reveal" aria-labelledby="article-title">
      <p class="eyebrow">{{ about.article.label }}</p>
      <h3 id="article-title">{{ about.article.title }}</h3>
      <p class="note-text">{{ about.article.text }}</p>
      <a class="app-action" href="{{ langPrefix }}/blog/how-this-site-was-built-by-agents/">{{ about.article.link }}<span class="arrow" aria-hidden="true">→</span></a>
    </aside>
  </div>
</section>
<section class="section contact" aria-labelledby="contact-title">
  <div class="container">
    {% include "partials/home/contact.njk" %}
  </div>
</section>
