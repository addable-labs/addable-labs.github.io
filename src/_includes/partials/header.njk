{#- Site header (REQ-014, REQ-022): sticky and blurred; brand (inline SVG mark,
    aria-hidden, + the live-text wordmark), main navigation with aria-current,
    then the controls — the language switch (a.lang-switch, kept for the pages
    gate) and the appearance toggle. WI-05 adds the small primary CTA on wide
    screens. The row wraps below 40 rem so the navigation is never hidden.
    Nav hrefs follow the URL contract: English at the root, Swedish under /sv/. -#}
{%- set langPrefix = "" if lang == site.languages.default else "/" + lang -%}
{%- set navItems = [
  { href: langPrefix + "/", label: strings[lang].nav.home },
  { href: langPrefix + "/about/", label: strings[lang].nav.about },
  { href: langPrefix + "/blog/", label: strings[lang].nav.blog }
] -%}
<header class="site-header">
  <div class="container header-row">
    <a class="brand" href="{{ langPrefix }}/">
      {% include "src/assets/img/mark.svg" %}
      <span class="wordmark">{{ strings[lang].site.wordmark }}<span class="wordmark-dim">{{ strings[lang].site.wordmarkDim }}</span></span>
    </a>
    <nav class="site-nav" aria-label="{{ strings[lang].nav.ariaLabel }}">
      <ul>
        {%- for item in navItems %}
        <li><a href="{{ item.href }}"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    <div class="header-controls">
      {%- include "partials/lang-switch.njk" %}
      {% include "partials/toggle.njk" %}
    </div>
  </div>
</header>
