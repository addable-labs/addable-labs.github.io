{#- Document head (REQ-010, REQ-016, REQ-007). `alternate`, `canonical` and
    `feedUrl` come from src/src.11tydata.js; absolute URLs go through the RSS
    plugin's absoluteUrl filter with site.url, so SITE_URL re-targets them all. -#}
{%- set siteName = strings[lang].site.name -%}
{%- if translationKey == "home" -%}
  {%- set pageTitle = siteName + " — " + strings[lang].site.tagline -%}
{%- else -%}
  {%- set pageTitle = title + " — " + siteName -%}
{%- endif -%}
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ canonical }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:type" content="{{ ogType or "website" }}">
  <meta property="og:locale" content="{{ "sv_SE" if lang == "sv" else "en_GB" }}">
  <meta property="og:site_name" content="{{ siteName }}">
{%- if alternate %}
  <link rel="alternate" hreflang="{{ lang }}" href="{{ page.url | absoluteUrl(site.url) }}">
  <link rel="alternate" hreflang="{{ alternate.lang }}" href="{{ alternate.url | absoluteUrl(site.url) }}">
  <link rel="alternate" hreflang="x-default" href="{{ (page.url if lang == site.languages.default else alternate.url) | absoluteUrl(site.url) }}">
{%- endif %}
  <link rel="alternate" type="application/rss+xml" title="{{ strings[lang].feed.title }}" href="{{ feedUrl | absoluteUrl(site.url) }}">
{#- Theme (REQ-007 as amended by A-03/A-04; plan D-09, D-13): dark for every
    first visit, light only through the stored toggle choice. One theme-color
    meta, the dark background, which the script rewrites after a toggle; the
    ~1 KB script is inlined (never a separate request) before the stylesheets
    so the theme is set before first paint on every page, including the
    language switch. The theme logic is scripts/lib/theme-logic.mjs, whose
    resolve() text the script must contain verbatim (tests/theme.test.mjs). #}
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#0B0E10">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <script>{% include "src/assets/js/theme.js" %}</script>
{#- Fonts (REQ-004, REQ-005; plan D-06): only the two weights above the fold
    are preloaded — Light for the h1, Medium for eyebrow, nav and buttons;
    Regular loads on demand with font-display: swap. Same-origin hrefs. #}
  <link rel="preload" href="/assets/fonts/JetBrainsMono-Light.woff2" as="font" type="font/woff2" crossorigin="anonymous">
  <link rel="preload" href="/assets/fonts/JetBrainsMono-Medium.woff2" as="font" type="font/woff2" crossorigin="anonymous">
  <link rel="stylesheet" href="/assets/css/fonts.css">
  <link rel="stylesheet" href="/assets/css/tokens.css">
  <link rel="stylesheet" href="/assets/css/base.css">
{#- Entrance motion (REQ-018): same-origin, ~0.9 KB, deferred — a module
    script runs after parsing like `defer` and avoids the bare boolean
    attribute, which Eleventy's IdAttributePlugin would serialise as defer=""
    (rejected by html-validate). The page is complete without it: nothing is
    hidden unless html.js is set. #}
  <script type="module" src="/assets/js/reveal.js"></script>
</head>
