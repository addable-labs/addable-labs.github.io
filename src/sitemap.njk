permalink: /sitemap.xml
eleventyExcludeFromCollections: true
aiGenerated: true
humanReviewed: true
---
{#- Every listed page of both languages (the 404 page, feeds, robots and this
    file are excluded from collections) with hreflang alternates (REQ-016,
    REQ-010). `listed` drops the articles dated after today: a scheduled
    article still builds at its real URL, but it is not advertised to search
    engines before the day it is dated (si-gxyg).
    The pages are listed in URL order (si-s3nr). collections.all comes in
    date order, and a page without a `date:` (every page here but the
    articles) is dated by its file's creation time, so without the sort each
    checkout would list those pages in its own order. `sort(false, true,
    "url")` is ascending and case-sensitive, so no two URLs tie and the
    order depends on the URLs alone. -#}
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for item in collections.all | listed | sort(false, true, "url") %}
{%- if item.data.translationKey and item.data.alternate %}
{%- set englishUrl = item.url if item.data.lang == site.languages.default else item.data.alternate.url %}
  <url>
    <loc>{{ item.url | absoluteUrl(site.url) }}</loc>
    <xhtml:link rel="alternate" hreflang="{{ item.data.lang }}" href="{{ item.url | absoluteUrl(site.url) }}"/>
    <xhtml:link rel="alternate" hreflang="{{ item.data.alternate.lang }}" href="{{ item.data.alternate.url | absoluteUrl(site.url) }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ englishUrl | absoluteUrl(site.url) }}"/>
  </url>
{%- endif %}
{%- endfor %}
</urlset>
