{
  "name": "addable-labs-website",
  "version": "0.1.0",
  "private": true,
  "description": "Addable Labs company website \u2014 Eleventy static site published with GitHub Pages",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.8"
  },
  "scripts": {
    "dev": "eleventy --serve",
    "build": "eleventy",
    "check": "node scripts/check/run.mjs",
    "check:links": "node scripts/check/links.mjs",
    "check:html": "html-validate \"_site/**/*.html\"",
    "check:pages": "node scripts/check/pages.mjs",
    "check:contrast": "node scripts/check/contrast.mjs",
    "check:parity": "node scripts/check/parity.mjs",
    "check:feeds": "node scripts/check/feeds.mjs",
    "check:content": "node scripts/check/content.mjs",
    "check:lighthouse": "node scripts/check/lighthouse.mjs",
    "check:layout": "node scripts/check/layout.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "walkthrough": "node scripts/walkthrough.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@11ty/eleventy-plugin-rss": "3.0.0",
    "chrome-launcher": "1.2.1",
    "fast-xml-parser": "5.11.1",
    "html-validate": "11.16.0",
    "js-yaml": "4.3.2",
    "lighthouse": "13.5.0",
    "luxon": "3.7.2",
    "node-html-parser": "9.0.4",
    "puppeteer-core": "25.11.0"
  }
}
